        ]
      },
      {
        "id": "u2",
        "title": "People & feelings",
        "goal": "Talk about family and friends and describe them with 很 and 的.",
        "steps": [
          { "id": "u2-vocab", "type": "vocab", "title": "People", "wordIds": ["hsk1-pengyou", "hsk1-xuesheng", "hsk1-mama", "hsk1-nver", "hsk1-renshi"] },
          { "id": "u2-vocab2", "type": "vocab", "title": "Describing", "wordIds": ["hsk1-gaoxing", "hsk1-piaoliang"] },
