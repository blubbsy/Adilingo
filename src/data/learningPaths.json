      },
      {
        "id": "u5",
        "title": "Time & events",
        "goal": "Talk about today and tomorrow, finished actions, and what didn't happen.",
        "steps": [
          { "id": "u5-vocab", "type": "vocab", "title": "Time", "wordIds": ["hsk1-jintian", "hsk1-mingtian", "hsk1-xianzai", "hsk1-xingqi"] },
          { "id": "u5-g-le", "type": "grammar", "grammarId": "g-le" },
          { "id": "u5-g-bumei", "type": "grammar", "grammarId": "g-bu-mei" },
